# Copy this file to .envrc and fill in the credentials required by your agent.
# The runner sources .envrc before launching Harbor.

# OpenAI-compatible / Codex agents
export OPENAI_BASE_URL="https://your-openai-compatible-endpoint/v1"
export OPENAI_API_KEY="replace-with-your-openai-api-key"
# export OPENAI_MODEL="openai/gpt-5.4"

# Claude Code / Anthropic agents
